# Turso database (Putumayo Run signups)
# Shared with the quinacare.org project — writes land in the
# putumayo_loop_subscribers table. Get credentials at https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# SMTP (Putumayo Run signup notification + confirmation mail)
# Same provider as quinacare.org (Resend). The MAIL_FROM domain must be
# verified at the provider so SPF/DKIM pass.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
MAIL_FROM=Hospital San Miguel <noreply@quinacare.org>
