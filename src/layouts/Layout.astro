---
import "/src/styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
  title: string;
  description: string;
  /** Absolute URL for the social share image (optional, falls back to default OG image) */
  image?: string;
  /** Canonical URL (optional, defaults to site root) */
  canonical?: string;
}

const { title, description, image, canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO {title} {description} {image} {canonical} />
  </head>
  <body class="bg-white text-dark">
    <slot />
  </body>
</html>
