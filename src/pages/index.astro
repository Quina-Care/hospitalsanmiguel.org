---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

import hospitalExterior from "../assets/images/hospital_exterior.jpg";
import externalConsultLanding from "../assets/images/external_consult_landing.jpg";
import hospitalizationLanding from "../assets/images/hospitalization_landing.jpg";
import radiologyConsultLanding from "../assets/images/radiology_consult_landing.jpg";
import pharmacyLanding from "../assets/images/pharmacy_landing.jpg";
import laboratoryLanding from "../assets/images/laboratory_landing.jpg";
import maternity from "../assets/images/maternity.jpg";
import community from "../assets/images/community.jpg";
import pregnancy from "../assets/images/pregnancy.jpg";
import emergencyLanding from "../assets/images/emergency_landing.jpg";
import doctors from "../assets/images/doctors.jpg";
---

<Layout
  title="Hospital San Miguel | El Carmen de Putumayo"
  description="Hospital San Miguel en El Carmen de Putumayo, Ecuador. Consulta médica, emergencias 24/7, radiografías, laboratorio, farmacia, maternidad y observación."
>
  <!-- Skip to main content (keyboard / screen reader) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:text-sm focus:font-bold"
  >
    Ir al contenido principal
  </a>

  <!-- ═══════════════════════════════════════════
       HEADER / NAV
       ═══════════════════════════════════════════ -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/96 backdrop-blur-md border-b border-gray-100/50 shadow-sm">
    <div class="max-w-[1400px] mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#inicio" class="flex items-center gap-3">
        <img src="/images/logo-hospitalsanmiguel.min.svg" alt="Logo Hospital San Miguel" class="h-14 w-auto" width="56" height="56" />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-8">
        <a href="#precios" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Precios</a>
        <a href="#servicios" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Servicios</a>
        <a href="#contacto" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Contacto</a>
        <a href="#nosotros" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Nosotros</a>
        <a href="#apoyo" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.1em] bg-primary text-white hover:bg-[#bf1122] transition-colors px-4 py-2 rounded"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>Apóyenos</a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100/50">
      <nav aria-label="Menú móvil" class="flex flex-col px-6 py-4 gap-4">
        <a href="#precios" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Precios</a>
        <a href="#servicios" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Servicios</a>
        <a href="#contacto" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Contacto</a>
        <a href="#nosotros" class="inline-flex items-center text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors py-2">Nosotros</a>
        <a href="#apoyo" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.1em] bg-primary text-white hover:bg-[#bf1122] transition-colors px-4 py-2 rounded"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>Apóyenos</a>
      </nav>
    </div>
  </header>

  <main id="main-content">

    <!-- ═══════════════════════════════════════════
         HERO BANNER
         ═══════════════════════════════════════════ -->
    <section id="inicio" aria-labelledby="hero-heading" class="relative min-h-[88vh] flex items-center justify-center overflow-hidden">
      <Image
        src={hospitalExterior}
        alt="Hospital San Miguel - Vista aérea del hospital junto al río en El Carmen de Putumayo"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        format="webp"
        quality={70}
        widths={[480, 800, 1200]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark/80 via-dark/50 to-dark/10" aria-hidden="true"></div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-6 pt-40 pb-28 w-full">
        <h1 id="hero-heading" class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] max-w-3xl">
          Hospital<br />San Miguel
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-white/90 max-w-xl leading-relaxed">
          Atención médica de calidad tanto para Puerto el Carmen como todas las comunidades ecuatorianas y colombianas.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#servicios" class="hsm-btn hsm-btn--primary">Nuestros Servicios</a>
          <a href="#contacto" class="hsm-btn hsm-btn--outline">Contáctenos</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         MISSION BANNER
         ═══════════════════════════════════════════ -->
    <div class="bg-dark py-5">
      <div class="max-w-[1400px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-center sm:text-left">
        <p class="text-sm text-white/90 leading-relaxed">
          <span class="font-bold text-white">No somos un hospital comercial.</span>
          Nuestros servicios son posibles gracias al apoyo de organizaciones benéficas internacionales y donantes particulares que creen en la salud como derecho.
        </p>
        <a href="#apoyo" class="text-sm font-bold uppercase tracking-[0.1em] text-white underline underline-offset-4 hover:no-underline whitespace-nowrap flex-shrink-0">
          Cómo contribuir →
        </a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════
         PRECIOS
         ═══════════════════════════════════════════ -->
    <section id="precios" aria-labelledby="precios-heading" class="py-24 bg-light">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="hsm-label mb-3">Lista de Precios</span>
          <h2 id="precios-heading" class="text-3xl md:text-5xl font-bold tracking-tight text-dark">
            Atención médica accesible
          </h2>
          <p class="hsm-body mt-4 max-w-2xl mx-auto">
            Ofrecemos tarifas accesibles para toda la comunidad.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <!-- Consulta Externa -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-primary px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Consulta Externa</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">Lunes a viernes: 8:00 - 16:00</p>
                <p class="text-sm text-gray-600">Domingo: 8:00 - 12:00</p>
              </div>
              <table class="w-full border-t border-gray-100 pt-4 mt-4 text-sm">
                <caption class="sr-only">Precios de Consulta Externa en USD y pesos colombianos</caption>
                <thead>
                  <tr>
                    <th class="text-left text-gray-600 font-normal pb-2 sr-only">Servicio</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2">USD</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2 pl-4">Pesos</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  <tr>
                    <td class="text-gray-600 py-2">Consulta general</td>
                    <td class="text-right font-bold text-dark py-2">$5.00</td>
                    <td class="text-right text-xs text-gray-500 py-2 pl-4">20.000</td>
                  </tr>
                  <tr>
                    <td class="text-gray-600 py-2">Consulta niño</td>
                    <td class="text-right font-bold text-dark py-2">$2.50</td>
                    <td class="text-right text-xs text-gray-500 py-2 pl-4">10.000</td>
                  </tr>
                  <tr>
                    <td class="text-gray-600 py-2">Consulta embarazada</td>
                    <td class="text-right font-bold text-dark py-2">$2.50</td>
                    <td class="text-right text-xs text-gray-500 py-2 pl-4">10.000</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Emergencia -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-dark px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Emergencia</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">24 horas al día</p>
                <p class="text-sm text-gray-600">7 días de la semana</p>
              </div>
              <table class="w-full border-t border-gray-100 pt-4 mt-4 text-sm">
                <caption class="sr-only">Precios de Emergencia en USD y pesos colombianos</caption>
                <thead>
                  <tr>
                    <th class="text-left text-gray-600 font-normal pb-2 sr-only">Servicio</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2">USD</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2 pl-4">Pesos</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  <tr>
                    <td class="text-gray-600 py-2">Consulta de emergencia</td>
                    <td class="text-right font-bold text-dark py-2">$15.00</td>
                    <td class="text-right text-xs text-gray-500 py-2 pl-4">60.000</td>
                  </tr>
                </tbody>
              </table>
              <p class="text-xs text-gray-500 mt-3 leading-relaxed">La atención de emergencia está garantizada sin condición de pago, conforme a la Constitución del Ecuador.</p>
            </div>
          </div>

          <!-- Observación -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-primary px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Observación</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">24 horas al día</p>
                <p class="text-sm text-gray-600">7 días de la semana</p>
              </div>
              <table class="w-full border-t border-gray-100 pt-4 mt-4 text-sm">
                <caption class="sr-only">Precios de Observación en USD y pesos colombianos</caption>
                <thead>
                  <tr>
                    <th class="text-left text-gray-600 font-normal pb-2 sr-only">Servicio</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2">USD</th>
                    <th class="text-right text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase pb-2 pl-4">Pesos</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                  <tr>
                    <td class="text-gray-600 py-2">Observación (hasta 24 horas)</td>
                    <td class="text-right font-bold text-dark py-2">$15.00</td>
                    <td class="text-right text-xs text-gray-500 py-2 pl-4">60.000</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SERVICIOS
         ═══════════════════════════════════════════ -->
    <section id="servicios" aria-labelledby="servicios-heading" class="py-24 bg-white">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="hsm-label mb-3">Nuestros Servicios</span>
          <h2 id="servicios-heading" class="text-3xl md:text-5xl font-bold tracking-tight text-dark">
            Atención médica integral
          </h2>
          <p class="hsm-body mt-4 max-w-2xl mx-auto">
            Contamos con personal médico capacitado y equipos modernos para brindar la mejor atención a nuestra comunidad.
          </p>
        </div>

        <!-- Service cards -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/servicios#consulta-externa" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={externalConsultLanding} alt="Médico en consulta con paciente en el Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Consulta Externa</h3>
            </div>
          </a>

          <a href="/servicios#hospitalizacion" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={hospitalizationLanding} alt="Paciente en cama de observación en el Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Hospitalización</h3>
            </div>
          </a>

          <a href="/servicios#laboratorio" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={laboratoryLanding} alt="Técnica de laboratorio analizando muestras en el laboratorio del Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Laboratorio Clínico</h3>
            </div>
          </a>

          <a href="/servicios#emergencia" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={emergencyLanding} alt="Equipo médico atendiendo una emergencia en el Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Emergencia 24/7</h3>
            </div>
          </a>

          <a href="/servicios#radiologia" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={radiologyConsultLanding} alt="Médico realizando consulta de radiología en el Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Radiología</h3>
            </div>
          </a>

          <a href="/servicios#farmacia" class="relative rounded-3xl overflow-hidden aspect-[3/2] group block">
            <Image src={pharmacyLanding} alt="Estantes con medicamentos en la farmacia del Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 600]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-2xl font-extrabold text-white">Farmacia</h3>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         CONTACTO
         ═══════════════════════════════════════════ -->
    <section id="contacto" aria-labelledby="contacto-heading" class="py-24 bg-light">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="hsm-label mb-3">Contacto</span>
          <h2 id="contacto-heading" class="text-3xl md:text-5xl font-bold tracking-tight text-dark">
            Medios de contacto
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto items-center">
          <div class="relative aspect-[3/2] overflow-hidden rounded-2xl shadow-md">
            <Image
              src={doctors}
              alt="Equipo médico del Hospital San Miguel"
              class="w-full h-full object-cover absolute inset-0"
              loading="lazy"
              format="webp"
              quality={75}
              widths={[400, 720]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          </div>
          <dl class="space-y-8">
            <div>
              <dt class="hsm-meta block mb-2">Dirección</dt>
              <dd style="color: var(--body-color)">Miguel Sedano 1, Puerto El Carmen del Putumayo, Ecuador</dd>
            </div>
            <div>
              <dt class="hsm-meta block mb-2">Teléfono / WhatsApp</dt>
              <dd>
                <a
                  href="https://wa.me/593939912321"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary font-bold hover:text-dark transition-colors"
                >
                  +593 93 991 2321
                  <span class="sr-only">(abre en nueva pestaña)</span>
                </a>
              </dd>
            </div>
            <div>
              <dt class="hsm-meta block mb-2">Horario Consulta Externa</dt>
              <dd style="color: var(--body-color)">
                <p>Lunes a viernes: 8:00 - 16:00</p>
                <p>Domingo: 8:00 - 12:00</p>
              </dd>
            </div>
            <div>
              <dt class="hsm-meta block mb-2">Emergencias</dt>
              <dd style="color: var(--body-color)">24 horas al día, 7 días de la semana</dd>
            </div>
            <div>
              <dt class="hsm-meta block mb-2">Redes Sociales</dt>
              <dd>
                <a
                  href="https://www.facebook.com/hospsanmiguel"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary font-bold hover:text-dark transition-colors"
                >
                  Facebook: @hospsanmiguel
                  <span class="sr-only">(abre en nueva pestaña)</span>
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         NOSOTROS
         ═══════════════════════════════════════════ -->
    <section id="nosotros" aria-labelledby="nosotros-heading" class="relative py-24 overflow-hidden">
      <Image
        src={community}
        alt="Actividad comunitaria de salud organizada por el Hospital San Miguel"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        format="webp"
        quality={65}
        widths={[480, 800, 1200]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark/80 via-dark/60 to-dark/30" aria-hidden="true"></div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-6">
        <div class="max-w-2xl">
          <span class="hsm-label mb-3" style="color: white;">Sobre Nosotros</span>
          <h2 id="nosotros-heading" class="text-3xl md:text-5xl font-bold text-white tracking-tight">
            Al servicio de nuestra comunidad
          </h2>
          <p class="hsm-body--light mt-6">
            El Hospital San Miguel está ubicado en El Carmen de Putumayo, Ecuador, a orillas del río. Brindamos atención médica accesible a toda la comunidad.
          </p>
          <p class="hsm-body--light mt-4">
            Nuestro hospital cuenta con consulta externa, servicio de emergencia 24/7, radiografías, laboratorio clínico propio, farmacia, sala de maternidad y área de observación.
          </p>
          <a href="#contacto" class="hsm-btn hsm-btn--primary mt-8">Contáctenos</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         EMBARAZO BANNER
         ═══════════════════════════════════════════ -->
    <!-- <section id="maternidad" aria-labelledby="maternidad-heading" class="py-24 bg-white">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <Image
              src={pregnancy}
              alt="Servicio de atención prenatal del Hospital San Miguel"
              class="rounded-2xl w-full shadow-md"
