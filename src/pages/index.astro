  <Footer />

  <!-- Minimal JS for mobile menu -->
  <script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const links = menu?.querySelectorAll("a");

    toggle?.addEventListener("click", () => {
      const isOpen = menu?.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
      if (isOpen) {
        const firstLink = menu?.querySelector("a");
        firstLink?.focus();
      }
    });

    links?.forEach((link) => {
      link.addEventListener("click", () => {
        menu?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.setAttribute("aria-label", "Abrir menú");
      });
    });
  </script>

  <!-- Putumayo Run signup + live counter -->
  <script>
    // Fill the registration tally on the banner from the live Turso counts.
    async function loadPutumayoCounts() {
      try {
        const res = await fetch("/api/putumayo-counts");
        if (!res.ok) return;
        const { putumayo, worldwide } = await res.json();
        document
          .querySelectorAll(".pr-count-putumayo")
          .forEach((el) => (el.textContent = String(putumayo)));
        document
          .querySelectorAll(".pr-count-worldwide")
          .forEach((el) => (el.textContent = String(worldwide)));
      } catch {
        /* leave the placeholder dashes if the count can't be fetched */
      }
    }
    loadPutumayoCounts();

    const prForm = document.getElementById("putumayo-run-form") as HTMLFormElement | null;
    prForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const label = prForm.querySelector(".pr-btn-label");
      const sending = prForm.querySelector(".pr-btn-sending");
      const error = prForm.querySelector(".pr-error");
      const submitBtn = prForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      error?.classList.add("hidden");
      label?.classList.add("hidden");
      sending?.classList.remove("hidden");
      if (submitBtn) submitBtn.disabled = true;

      const data = new FormData(prForm);

      // The 1 km fun run is children-only (up to 12). Catch it here so the
      // runner gets a clear message rather than a generic server error.
      const distance = String(data.get("distance") ?? "");
      const ageVal = Number(data.get("age"));
      if (distance === "1k" && (!Number.isInteger(ageVal) || ageVal > 12)) {
        if (error) {
          error.textContent =
            "La carrera de 1 km es solo para niñas y niños de hasta 12 años. Indique la edad.";
          error.classList.remove("hidden");
        }
        label?.classList.remove("hidden");
        sending?.classList.add("hidden");
        if (submitBtn) submitBtn.disabled = false;
        return;
      }

      try {
        const res = await fetch("/api/putumayo-signup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            email: data.get("email"),
            age: data.get("age"),
            distance: data.get("distance"),
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        prForm.classList.add("hidden");
        document.querySelector(".pr-success")?.classList.remove("hidden");
        // Reflect the new registration in the badge straight away.
        loadPutumayoCounts();
      } catch {
        if (error) {
          error.textContent =
            "No se pudo completar la inscripción. Inténtelo de nuevo.";
          error.classList.remove("hidden");
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        label?.classList.remove("hidden");
        sending?.classList.add("hidden");
      }
    });
  </script>
