---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

import hospitalExterior from "../assets/images/hospital-exterior.jpg";
import laboratorio from "../assets/images/laboratorio.jpg";
import cirugia from "../assets/images/cirugia.jpg";
import maternidad from "../assets/images/maternidad.jpg";
import comunidad from "../assets/images/comunidad.jpg";
import embarazo from "../assets/images/embarazo.jpg";
---

<Layout
  title="Hospital del Día San Miguel | El Carmen de Putumayo"
  description="Hospital en El Carmen de Putumayo, Ecuador. Consulta médica, emergencias 24/7, radiografías, laboratorio, farmacia, maternidad y hospitalización."
>
  <!-- ═══════════════════════════════════════════
       HEADER / NAV
       ═══════════════════════════════════════════ -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
    <div class="max-w-[1400px] mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#inicio" class="flex items-center gap-3">
        <img src="/images/logo-hospitalsanmiguel.min.svg" alt="Logo Hospital del Día San Miguel" class="h-14 w-auto" width="56" height="56" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8">
        <a href="#servicios" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Servicios</a>
        <a href="#precios" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Precios</a>
        <a href="#nosotros" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Nosotros</a>
        <a href="#contacto" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Contacto</a>
      </nav>

      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="lg:hidden p-2" aria-label="Abrir menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
      <nav class="flex flex-col px-6 py-4 gap-4">
        <a href="#servicios" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Servicios</a>
        <a href="#precios" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Precios</a>
        <a href="#nosotros" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Nosotros</a>
        <a href="#contacto" class="text-sm font-bold uppercase tracking-[0.15em] text-hsmBlack hover:text-hsmRed transition-colors">Contacto</a>
      </nav>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════
       HERO BANNER
       ═══════════════════════════════════════════ -->
  <section id="inicio" class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <Image
      src={hospitalExterior}
      alt="Hospital del Día San Miguel - Vista aérea del hospital junto al río en El Carmen de Putumayo"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={70}
      widths={[480, 800, 1200]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-hsmBlack/80 via-hsmBlack/60 to-transparent"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 py-32 w-full">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-tight max-w-3xl">
        Hospital del Día<br />San Miguel
      </h1>
      <p class="mt-6 text-lg md:text-xl text-white/70 max-w-xl leading-relaxed">
        Atención médica de calidad para la comunidad de El Carmen de Putumayo, Ecuador. Abiertos para usted, cada día.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#servicios" class="hsm-btn hsm-btn--primary">Nuestros Servicios</a>
        <a href="#contacto" class="hsm-btn hsm-btn--outline">Contáctenos</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SERVICIOS
       ═══════════════════════════════════════════ -->
  <section id="servicios" class="py-24 bg-white">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="hsm-label mb-3">Nuestros Servicios</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-hsmBlack">
          Atención médica integral
        </h2>
        <p class="hsm-body mt-4 max-w-2xl mx-auto">
          Contamos con personal médico capacitado y equipos modernos para brindar la mejor atención a nuestra comunidad.
        </p>
      </div>

      <!-- Image cards row -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        <div class="relative rounded-lg overflow-hidden aspect-[4/3] group">
          <Image src={laboratorio} alt="Laboratorio clínico del Hospital del Día San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 720]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-hsmBlack/80 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-lg font-bold text-white mb-1">Laboratorio Clínico</h3>
            <p class="text-white/80 text-sm">Hemograma completo (HC) y análisis clínicos</p>
          </div>
        </div>

        <div class="relative rounded-lg overflow-hidden aspect-[4/3] group">
          <Image src={cirugia} alt="Sala de cirugía del Hospital del Día San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 720]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-hsmBlack/80 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-lg font-bold text-white mb-1">Cirugía</h3>
            <p class="text-white/80 text-sm">Ligadura y mini-cesáreas todos los días</p>
          </div>
        </div>

        <div class="relative rounded-lg overflow-hidden aspect-[4/3] group">
          <Image src={maternidad} alt="Equipo de maternidad del Hospital del Día San Miguel con bebés recién nacidos" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 720]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-hsmBlack/80 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <h3 class="text-lg font-bold text-white mb-1">Cuidado Materno</h3>
            <p class="text-white/80 text-sm">Atención de partos y cuidado prenatal</p>
          </div>
        </div>
      </div>

      <!-- Icon cards row -->
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="group border border-gray-100 rounded-lg p-6 hover:border-hsmRed/20 transition-colors">
          <div class="w-10 h-10 bg-hsmRed/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-hsmBlack mb-2">Consulta General</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Atención médica para adultos y niños de lunes a viernes y domingos.</p>
        </div>

        <div class="group border border-gray-100 rounded-lg p-6 hover:border-hsmRed/20 transition-colors">
          <div class="w-10 h-10 bg-hsmRed/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-hsmBlack mb-2">Emergencia 24/7</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Servicio de emergencia las 24 horas, los 7 días de la semana.</p>
        </div>

        <div class="group border border-gray-100 rounded-lg p-6 hover:border-hsmRed/20 transition-colors">
          <div class="w-10 h-10 bg-hsmRed/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-hsmBlack mb-2">Radiografías</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Rayos X para diagnóstico por imágenes con resultados rápidos.</p>
        </div>

        <div class="group border border-gray-100 rounded-lg p-6 hover:border-hsmRed/20 transition-colors">
          <div class="w-10 h-10 bg-hsmRed/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <h3 class="text-lg font-bold text-hsmBlack mb-2">Farmacia</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Medicamentos esenciales disponibles directamente en el hospital.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PRECIOS
       ═══════════════════════════════════════════ -->
  <section id="precios" class="py-24 bg-white">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="hsm-label mb-3">Lista de Precios</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-hsmBlack">
          Atención médica accesible
        </h2>
        <p class="hsm-body mt-4 max-w-2xl mx-auto">
          Ofrecemos tarifas accesibles para toda la comunidad.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Consulta Externa -->
        <div class="border border-gray-100 rounded-lg overflow-hidden">
          <div class="bg-hsmRed p-6">
            <h3 class="text-lg font-bold text-white uppercase tracking-wide">Consulta Externa</h3>
          </div>
          <div class="p-6">
            <div class="mb-4">
              <span class="hsm-meta block mb-1">Horario</span>
              <p class="text-sm text-gray-600">Lunes a viernes: 8am - 12pm | 2pm - 4pm</p>
              <p class="text-sm text-gray-600">Domingo: 8am - 12pm</p>
            </div>
            <div class="border-t border-gray-100 pt-4 space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Consulta general</span>
                <span class="font-bold text-hsmBlack">$5.00</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Consulta niño</span>
                <span class="font-bold text-hsmBlack">$2.50</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Consulta embarazada</span>
                <span class="font-bold text-hsmBlack">$2.50</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Emergencia -->
        <div class="border border-gray-100 rounded-lg overflow-hidden">
          <div class="bg-hsmBlack p-6">
            <h3 class="text-lg font-bold text-white uppercase tracking-wide">Emergencia</h3>
          </div>
          <div class="p-6">
            <div class="mb-4">
              <span class="hsm-meta block mb-1">Horario</span>
              <p class="text-sm text-gray-600">24 horas al día</p>
              <p class="text-sm text-gray-600">7 días de la semana</p>
            </div>
            <div class="border-t border-gray-100 pt-4 space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Consulta de emergencia</span>
                <span class="font-bold text-hsmBlack">$15.00</span>
              </div>
              <p class="text-xs text-gray-500 mt-2">60.000 pesos colombianos</p>
            </div>
          </div>
        </div>

        <!-- Hospitalización -->
        <div class="border border-gray-100 rounded-lg overflow-hidden">
          <div class="bg-hsmRed p-6">
            <h3 class="text-lg font-bold text-white uppercase tracking-wide">Hospitalización</h3>
          </div>
          <div class="p-6">
            <div class="mb-4">
              <span class="hsm-meta block mb-1">Horario</span>
              <p class="text-sm text-gray-600">24 horas al día</p>
              <p class="text-sm text-gray-600">7 días de la semana</p>
            </div>
            <div class="border-t border-gray-100 pt-4 space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600">Noche de hospitalización</span>
                <span class="font-bold text-hsmBlack">$15.00</span>
              </div>
              <p class="text-xs text-gray-500 mt-2">60.000 pesos colombianos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       NOSOTROS
       ═══════════════════════════════════════════ -->
  <section id="nosotros" class="relative py-24 overflow-hidden">
    <Image
      src={comunidad}
      alt="Actividad comunitaria de salud organizada por el Hospital del Día San Miguel"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      format="webp"
      quality={65}
      widths={[480, 800, 1200]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-hsmBlack/75"></div>
    <div class="relative z-10 max-w-[1400px] mx-auto px-6">
      <div class="max-w-2xl">
        <span class="hsm-label mb-3" style="color: white;">Sobre Nosotros</span>
        <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
          Al servicio de nuestra comunidad
        </h2>
        <p class="hsm-body--light mt-6">
          El Hospital del Día San Miguel está ubicado en El Carmen de Putumayo, Ecuador, a orillas del río. Brindamos atención médica accesible a toda la comunidad.
        </p>
        <p class="hsm-body--light mt-4">
          Nuestro hospital cuenta con consulta externa, servicio de emergencia 24/7, radiografías, laboratorio clínico propio, farmacia, sala de maternidad y área de hospitalización.
        </p>
        <a href="#contacto" class="hsm-btn hsm-btn--primary mt-8">Contáctenos</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       EMBARAZO BANNER
       ═══════════════════════════════════════════ -->
  <section class="py-24 bg-white">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <Image
            src={embarazo}
            alt="Servicio de atención prenatal del Hospital del Día San Miguel"
            class="rounded-lg w-full"
            loading="lazy"
            format="webp"
            quality={75}
            widths={[400, 720]}
            sizes="(min-width: 768px) 50vw, 100vw"
          />
        </div>
        <div>
          <span class="hsm-label mb-3">Cuidado Materno</span>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-hsmBlack">
            ¿Está embarazada? La atendemos
          </h2>
          <p class="hsm-body mt-4">
            Ofrecemos atención completa para madres embarazadas, incluyendo partos y cesáreas. Acuda a la consulta de obstetricia y solicite información.
          </p>
          <div class="mt-8 flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-hsmRed/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-gray-600">Atención de partos naturales</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-hsmRed/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-gray-600">Cesáreas y mini-cesáreas</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-hsmRed/10 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hsmRed" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-gray-600">Consulta prenatal - $2.50</span>
            </div>
          </div>
          <a href="https://wa.me/593939912321" target="_blank" rel="noopener noreferrer" class="hsm-btn hsm-btn--primary mt-8">
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONTACTO
       ═══════════════════════════════════════════ -->
  <section id="contacto" class="py-24 bg-hsmGray">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="text-center mb-16">
        <span class="hsm-label mb-3">Contacto</span>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-hsmBlack">
          ¿Cómo contactarnos?
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        <div class="space-y-8">
          <div>
            <span class="hsm-meta block mb-2">Dirección</span>
            <p class="text-gray-600">Miguel Sedano 1, Puerto El Carmen del Putumayo, Ecuador</p>
          </div>
          <div>
            <span class="hsm-meta block mb-2">Teléfono / WhatsApp</span>
            <a href="https://wa.me/593939912321" target="_blank" rel="noopener noreferrer" class="text-hsmRed font-bold hover:text-hsmBlack transition-colors">
              +593 93 991 2321
            </a>
          </div>
          <div>
            <span class="hsm-meta block mb-2">Horario Consulta Externa</span>
            <p class="text-gray-600">Lunes a viernes: 8:00 - 12:00 | 14:00 - 16:00</p>
            <p class="text-gray-600">Domingo: 8:00 - 12:00</p>
          </div>
          <div>
            <span class="hsm-meta block mb-2">Emergencias</span>
            <p class="text-gray-600">24 horas al día, 7 días de la semana</p>
          </div>
          <div>
            <span class="hsm-meta block mb-2">Redes Sociales</span>
            <a href="https://www.facebook.com/hospsanmiguel" target="_blank" rel="noopener noreferrer" class="text-hsmRed font-bold hover:text-hsmBlack transition-colors">
              Facebook: @hospsanmiguel
            </a>
          </div>
        </div>

        <div class="bg-white rounded-lg p-8">
          <h3 class="text-lg font-bold text-hsmBlack mb-4">Servicios Disponibles</h3>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Consulta médica general</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Emergencia 24/7</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Radiografías (Rayos X)</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Laboratorio clínico propio</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Farmacia</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-hsmRed flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-600">Cuidado materno (partos y cesáreas)</span>
            </li>
            <li class="flex items-center gap-3">
