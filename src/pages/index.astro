---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

import hospitalExterior from "../assets/images/hospital-exterior.jpg";
import laboratorio from "../assets/images/laboratorio.jpg";
import maternidad from "../assets/images/maternidad.jpg";
import comunidad from "../assets/images/comunidad.jpg";
import embarazo from "../assets/images/embarazo.jpg";
---

<Layout
  title="Hospital San Miguel | El Carmen de Putumayo"
  description="Hospital San Miguel en El Carmen de Putumayo, Ecuador. Consulta médica, emergencias 24/7, radiografías, laboratorio, farmacia, maternidad y observación."
>
  <!-- Skip to main content (keyboard / screen reader) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:text-sm focus:font-bold"
  >
    Ir al contenido principal
  </a>

  <!-- ═══════════════════════════════════════════
       HEADER / NAV
       ═══════════════════════════════════════════ -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-white/96 backdrop-blur-md border-b border-gray-100/50 shadow-sm">
    <div class="max-w-[1400px] mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#inicio" class="flex items-center gap-3">
        <img src="/images/logo-hospitalsanmiguel.min.svg" alt="Logo Hospital San Miguel" class="h-14 w-auto" width="56" height="56" />
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-8">
        <a href="#servicios" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Servicios</a>
        <a href="#precios" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Precios</a>
        <a href="#nosotros" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Nosotros</a>
        <a href="#contacto" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Contacto</a>
        <a href="#apoyo" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.1em] bg-primary text-white hover:bg-[#bf1122] transition-colors px-4 py-2 rounded"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>Apóyanos</a>
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100/50">
      <nav aria-label="Menú móvil" class="flex flex-col px-6 py-4 gap-4">
        <a href="#servicios" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Servicios</a>
        <a href="#precios" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Precios</a>
        <a href="#nosotros" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Nosotros</a>
        <a href="#contacto" class="text-sm font-bold uppercase tracking-[0.15em] text-dark hover:text-primary transition-colors">Contacto</a>
        <a href="#apoyo" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.1em] bg-primary text-white hover:bg-[#bf1122] transition-colors px-4 py-2 rounded"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>Apóyanos</a>
      </nav>
    </div>
  </header>

  <main id="main-content">

    <!-- ═══════════════════════════════════════════
         HERO BANNER
         ═══════════════════════════════════════════ -->
    <section id="inicio" aria-labelledby="hero-heading" class="relative min-h-[88vh] flex items-center justify-center overflow-hidden">
      <Image
        src={hospitalExterior}
        alt="Hospital San Miguel - Vista aérea del hospital junto al río en El Carmen de Putumayo"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        format="webp"
        quality={70}
        widths={[480, 800, 1200]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark/80 via-dark/50 to-dark/10" aria-hidden="true"></div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-6 pt-40 pb-28 w-full">
        <h1 id="hero-heading" class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] max-w-3xl">
          Hospital<br />San Miguel
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-white/90 max-w-xl leading-relaxed">
          Atención médica de calidad para Puerto el Carmen y todas las comunidades ecuatorianas y colombianas de los alrededores.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#servicios" class="hsm-btn hsm-btn--primary">Nuestros Servicios</a>
          <a href="#contacto" class="hsm-btn hsm-btn--outline">Contáctenos</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         MISSION BANNER
         ═══════════════════════════════════════════ -->
    <div class="bg-dark py-5">
      <div class="max-w-[1400px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6 text-center sm:text-left">
        <p class="text-sm text-white/90 leading-relaxed">
          <span class="font-bold text-white">No somos un hospital comercial.</span>
          Nuestros servicios son posibles gracias al apoyo de organizaciones benéficas internacionales y donantes particulares que creen en la salud como derecho.
        </p>
        <a href="#apoyo" class="text-sm font-bold uppercase tracking-[0.1em] text-white underline underline-offset-4 hover:no-underline whitespace-nowrap flex-shrink-0">
          Cómo contribuir →
        </a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════
         SERVICIOS
         ═══════════════════════════════════════════ -->
    <section id="servicios" aria-labelledby="servicios-heading" class="py-24 bg-white">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="hsm-label mb-3">Nuestros Servicios</span>
          <h2 id="servicios-heading" class="text-3xl md:text-5xl font-bold tracking-tight text-dark">
            Atención médica integral
          </h2>
          <p class="hsm-body mt-4 max-w-2xl mx-auto">
            Contamos con personal médico capacitado y equipos modernos para brindar la mejor atención a nuestra comunidad.
          </p>
        </div>

        <!-- Image cards row -->
        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <a href="/servicios#consulta-externa" class="relative rounded-3xl overflow-hidden aspect-[4/3] group block">
            <Image src={laboratorio} alt="Consulta externa del Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 720]} sizes="(min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-lg font-bold text-white mb-1">Consulta Externa</h3>
              <p class="text-white/80 text-sm">Atención médica para adultos y niños</p>
            </div>
          </a>

          <a href="/servicios#hospitalizacion" class="relative rounded-3xl overflow-hidden aspect-[4/3] group block">
            <Image src={maternidad} alt="Hospitalización del Hospital San Miguel" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" format="webp" quality={75} widths={[400, 720]} sizes="(min-width: 768px) 50vw, 100vw" />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/85 via-dark/20 to-transparent" aria-hidden="true"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-lg font-bold text-white mb-1">Hospitalización</h3>
              <p class="text-white/80 text-sm">Observación y cuidado continuo hasta 24 horas</p>
            </div>
          </a>
        </div>

        <!-- Icon cards row -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">

          <a href="/servicios#emergencia" class="group relative overflow-hidden rounded-2xl p-7 bg-light hover:bg-primary/10 transition-colors duration-300 block">
            <div class="h-[2px] bg-primary rounded-full mb-6 w-8 group-hover:w-14 transition-[width] duration-500 ease-out"></div>
            <svg class="w-7 h-7 text-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            <h3 class="text-lg font-semibold text-dark mb-2">Emergencia 24/7</h3>
            <p class="text-sm leading-relaxed" style="color: var(--body-color)">Servicio de emergencia las 24 horas, los 7 días de la semana.</p>
          </a>

          <a href="/servicios#laboratorio" class="group relative overflow-hidden rounded-2xl p-7 bg-light hover:bg-primary/10 transition-colors duration-300 block">
            <div class="h-[2px] bg-primary rounded-full mb-6 w-8 group-hover:w-14 transition-[width] duration-500 ease-out"></div>
            <svg class="w-7 h-7 text-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            <h3 class="text-lg font-semibold text-dark mb-2">Laboratorio Clínico</h3>
            <p class="text-sm leading-relaxed" style="color: var(--body-color)">Hemograma completo y análisis clínicos con resultados rápidos.</p>
          </a>

          <a href="/servicios#radiologia" class="group relative overflow-hidden rounded-2xl p-7 bg-light hover:bg-primary/10 transition-colors duration-300 block">
            <div class="h-[2px] bg-primary rounded-full mb-6 w-8 group-hover:w-14 transition-[width] duration-500 ease-out"></div>
            <svg class="w-7 h-7 text-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <h3 class="text-lg font-semibold text-dark mb-2">Radiología</h3>
            <p class="text-sm leading-relaxed" style="color: var(--body-color)">Rayos X para diagnóstico por imágenes con resultados rápidos.</p>
          </a>

          <a href="/servicios#farmacia" class="group relative overflow-hidden rounded-2xl p-7 bg-light hover:bg-primary/10 transition-colors duration-300 block">
            <div class="h-[2px] bg-primary rounded-full mb-6 w-8 group-hover:w-14 transition-[width] duration-500 ease-out"></div>
            <svg class="w-7 h-7 text-primary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            <h3 class="text-lg font-semibold text-dark mb-2">Farmacia</h3>
            <p class="text-sm leading-relaxed" style="color: var(--body-color)">Medicamentos esenciales disponibles directamente en el hospital.</p>
          </a>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         PRECIOS
         ═══════════════════════════════════════════ -->
    <section id="precios" aria-labelledby="precios-heading" class="py-24 bg-light">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="hsm-label mb-3">Lista de Precios</span>
          <h2 id="precios-heading" class="text-3xl md:text-5xl font-bold tracking-tight text-dark">
            Atención médica accesible
          </h2>
          <p class="hsm-body mt-4 max-w-2xl mx-auto">
            Ofrecemos tarifas accesibles para toda la comunidad. Precios finales, servicios de salud exentos de IVA.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <!-- Consulta Externa -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-primary px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Consulta Externa</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">Lunes a viernes: 8am - 12pm | 2pm - 4pm</p>
                <p class="text-sm text-gray-600">Domingo: 8am - 12pm</p>
              </div>
              <dl class="border-t border-gray-100 pt-4 space-y-3">
                <div class="flex justify-end mb-1">
                  <span class="text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase">USD · COP</span>
                </div>
                <div class="flex justify-between items-start gap-4">
                  <dt class="text-sm text-gray-600 pt-0.5">Consulta general</dt>
                  <dd class="text-right shrink-0">
                    <span class="block font-bold text-dark leading-snug">$5.00</span>
                    <span class="block text-xs text-gray-400 leading-snug mt-0.5">20.000 COP</span>
                  </dd>
                </div>
                <div class="flex justify-between items-start gap-4">
                  <dt class="text-sm text-gray-600 pt-0.5">Consulta niño</dt>
                  <dd class="text-right shrink-0">
                    <span class="block font-bold text-dark leading-snug">$2.50</span>
                    <span class="block text-xs text-gray-400 leading-snug mt-0.5">10.000 COP</span>
                  </dd>
                </div>
                <div class="flex justify-between items-start gap-4">
                  <dt class="text-sm text-gray-600 pt-0.5">Consulta embarazada</dt>
                  <dd class="text-right shrink-0">
                    <span class="block font-bold text-dark leading-snug">$2.50</span>
                    <span class="block text-xs text-gray-400 leading-snug mt-0.5">10.000 COP</span>
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <!-- Emergencia -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-dark px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Emergencia</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">24 horas al día</p>
                <p class="text-sm text-gray-600">7 días de la semana</p>
              </div>
              <dl class="border-t border-gray-100 pt-4 space-y-3">
                <div class="flex justify-end mb-1">
                  <span class="text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase">USD · COP</span>
                </div>
                <div class="flex justify-between items-start gap-4">
                  <dt class="text-sm text-gray-600 pt-0.5">Consulta de emergencia</dt>
                  <dd class="text-right shrink-0">
                    <span class="block font-bold text-dark leading-snug">$15.00</span>
                    <span class="block text-xs text-gray-400 leading-snug mt-0.5">60.000 COP</span>
                  </dd>
                </div>
                <div>
                  <p class="text-xs text-gray-400 mt-3 leading-relaxed">La atención de emergencia está garantizada sin condición de pago, conforme a la Constitución del Ecuador.</p>
                </div>
              </dl>
            </div>
          </div>

          <!-- Observación -->
          <div class="bg-white shadow-md rounded-2xl overflow-hidden">
            <div class="bg-primary px-6 py-5">
              <h3 class="text-sm font-bold text-white uppercase tracking-[0.12em]">Observación</h3>
            </div>
            <div class="p-6">
              <div class="mb-4">
                <span class="hsm-meta block mb-1">Horario</span>
                <p class="text-sm text-gray-600">24 horas al día</p>
                <p class="text-sm text-gray-600">7 días de la semana</p>
              </div>
              <dl class="border-t border-gray-100 pt-4 space-y-3">
                <div class="flex justify-end mb-1">
                  <span class="text-[10px] tracking-[0.15em] font-bold text-gray-300 uppercase">USD · COP</span>
                </div>
                <div class="flex justify-between items-start gap-4">
                  <dt class="text-sm text-gray-600 pt-0.5">Observación (hasta 24 horas)</dt>
                  <dd class="text-right shrink-0">
                    <span class="block font-bold text-dark leading-snug">$15.00</span>
                    <span class="block text-xs text-gray-400 leading-snug mt-0.5">60.000 COP</span>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         NOSOTROS
         ═══════════════════════════════════════════ -->
    <section id="nosotros" aria-labelledby="nosotros-heading" class="relative py-24 overflow-hidden">
      <Image
        src={comunidad}
        alt="Actividad comunitaria de salud organizada por el Hospital San Miguel"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        format="webp"
        quality={65}
        widths={[480, 800, 1200]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-dark/80 via-dark/60 to-dark/30" aria-hidden="true"></div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-6">
        <div class="max-w-2xl">
          <span class="hsm-label mb-3" style="color: white;">Sobre Nosotros</span>
          <h2 id="nosotros-heading" class="text-3xl md:text-5xl font-bold text-white tracking-tight">
            Al servicio de nuestra comunidad
          </h2>
          <p class="hsm-body--light mt-6">
            El Hospital San Miguel está ubicado en El Carmen de Putumayo, Ecuador, a orillas del río. Brindamos atención médica accesible a toda la comunidad.
          </p>
          <p class="hsm-body--light mt-4">
            Nuestro hospital cuenta con consulta externa, servicio de emergencia 24/7, radiografías, laboratorio clínico propio, farmacia, sala de maternidad y área de observación.
          </p>
          <a href="#contacto" class="hsm-btn hsm-btn--primary mt-8">Contáctenos</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         EMBARAZO BANNER
         ═══════════════════════════════════════════ -->
    <section id="maternidad" aria-labelledby="maternidad-heading" class="py-24 bg-white">
      <div class="max-w-[1400px] mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <Image
              src={embarazo}
              alt="Servicio de atención prenatal del Hospital San Miguel"
              class="rounded-2xl w-full shadow-md"
              loading="lazy"
              format="webp"
              quality={75}
              widths={[400, 720]}
              sizes="(min-width: 768px) 50vw, 100vw"
            />
          </div>
          <div>
            <span class="hsm-label mb-3">Cuidado Materno</span>
            <h2 id="maternidad-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-dark">
              ¿Está embarazada? La atendemos
            </h2>
            <p class="hsm-body mt-4">
              Ofrecemos atención completa para madres embarazadas, incluyendo partos y cesáreas. Acuda a la consulta de obstetricia y solicite información.
            </p>
            <ul class="mt-8 flex flex-col gap-4" aria-label="Servicios de maternidad">
              <li class="flex items-center gap-3">
                <span class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span style="color: var(--body-color)">Atención de partos naturales</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span style="color: var(--body-color)">Cesáreas y mini-cesáreas</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span style="color: var(--body-color)">Consulta prenatal —
                  <span class="font-bold text-dark">$2.50</span>
                  <span class="text-xs text-gray-400">/ 10.000 COP</span>
                </span>
              </li>
            </ul>
            <a
              href="https://wa.me/593939912321"
              target="_blank"
              rel="noopener noreferrer"
